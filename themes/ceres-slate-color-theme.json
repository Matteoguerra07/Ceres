  "tokenColors": [
    {
      "name": "Commenti",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d8f96",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Stringhe",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a8e6c0"
      }
    },
    {
      "name": "Escape e speciali",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#f2a0c8"
      }
    },
    {
      "name": "Numeri e costanti",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffd88a"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f58f86"
      }
    },
    {
      "name": "Operatori",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8a92b8"
      }
    },
    {
      "name": "Punteggiatura",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8a92b8"
      }
    },
    {
      "name": "Funzioni",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8ab4ff"
      }
    },
    {
      "name": "Tipi e classi",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7fdbe0"
      }
    },
    {
      "name": "Parametri",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#ffae8a"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#ffae8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Proprieta'",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#b9a7ff"
      }
    },
    {
      "name": "Decoratori e annotazioni",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#b9a7ff"
      }
    },
    {
      "name": "Tag HTML/JSX",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#f58f86"
      }
    },
    {
      "name": "Attributi",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e5b95c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selettori classe/id",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#ffd88a"
      }
    },
    {
      "name": "CSS proprieta'",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#b9a7ff"
      }
    },
    {
      "name": "CSS valori e unita'",
      "scope": [
        "keyword.other.unit",
        "support.constant.property-value.css",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#7fdbe0"
      }
    },
    {
      "name": "CSS variabili",
      "scope": [
        "variable.css",
        "variable.argument.css",
        "support.type.custom-property.name"
      ],
      "settings": {
        "foreground": "#ffae8a"
      }
    },
    {
      "name": "JSON chiavi",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#b9a7ff"
      }
    },
    {
      "name": "Markdown titoli",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8ab4ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown grassetto",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e5b95c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown corsivo",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f58f86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown codice",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#a8e6c0"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7fdbe0"
      }
    },
    {
      "name": "Diff inserito",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#62c07a"
      }
    },
    {
      "name": "Diff rimosso",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e8707a"
      }
    },
    {
      "name": "Diff modificato",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e5b95c"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e8707a"
      }
    }
  ],
  "semanticTokenColors": {
    "property": "#b9a7ff",
    "parameter": "#ffae8a",
    "enumMember": "#ffd88a",
    "*.defaultLibrary": {
      "foreground": "#8ab4ff"
    },
    "variable.defaultLibrary": "#ffae8a"
  }
}
